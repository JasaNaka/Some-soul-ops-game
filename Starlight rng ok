-- 2. LOGIC TÌM QUÁI & XỬ LÝ WEAPON
local isFarming = false
local currentTarget = nil

-- TỰ ĐỘNG BẬT LẠI NOCLIP KHI RESPAWN
player.CharacterAdded:Connect(function(newCharacter)
	if isFarming then
		task.wait(1) -- Chờ character load đầy đủ
		if newCharacter then
			for _, part in ipairs(newCharacter:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
end)

local function getEnemyContainer()
	local targetFilter = Workspace:FindFirstChild("TargetFilter")
	if targetFilter then
		return targetFilter:FindFirstChild("Enemy")
	end
	return nil
end

local function getClosestEnemy()
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
	local hrp = character.HumanoidRootPart

	local enemyGroup = getEnemyContainer()
	if not enemyGroup then return nil end

	local closest = nil
	local shortestDistance = math.huge

	for _, child in ipairs(enemyGroup:GetChildren()) do
		if child:IsA("Model") then
			local valuesFolder = child:FindFirstChild("Values")
			local hpValue = valuesFolder and valuesFolder:FindFirstChild("HP")
			
			if not hpValue or hpValue.Value > 0 then
				local enemyPart = child.PrimaryPart or child:FindFirstChild("HumanoidRootPart") or child:FindFirstChildWhichIsA("BasePart")
				if enemyPart then
					local distance = (hrp.Position - enemyPart.Position).Magnitude
					if distance < shortestDistance then
						closest = child
						shortestDistance = distance
					end
				end
			end
		end
	end
	return closest
end

-- GIẢ LẬP NHẤN PHÍM ZXC
local function pressKey(keyCode)
	VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
	task.wait(0.05)
	VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

-- TRANG BỊ TOOL THEO TÊN (HỖ TRỢ TỰ EQUIP LẠI KHI RESPAWN / MỚI CHẾT XONG)
local function equipTool(toolName)
	if not toolName or toolName == "" then return nil end
	local character = player.Character
	if not character then return nil end
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil end

	local backpack = player:FindFirstChild("Backpack")

	-- Kiểm tra nếu đã cầm đúng tool trên tay
	local currentTool = character:FindFirstChildOfClass("Tool")
	if currentTool and currentTool.Name:lower() == toolName:lower() then
		return currentTool
	end

	-- Tìm trong Backpack để cầm ra
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and tool.Name:lower() == toolName:lower() then
				humanoid:EquipTool(tool)
				return tool
			end
		end
	end
	return nil
end

-- LUỒNG COMBO ZXC VÀ SPAM M1 (TỰ ĐỘNG EQUIP KHI CHẾT DÙNG LẠI)
task.spawn(function()
	local weaponToggle = false
	local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C}

	while true do
		if isFarming then
			local character = player.Character
			local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")

			-- Nếu nhân vật đang sống mới thực hiện Equip & Đánh
			if humanoid and humanoid.Health > 0 then
				if not currentTarget then
					currentTarget = getClosestEnemy()
				end

				local w1 = weapon1Box.Text:match("^%s*(.-)%s*$")
				local w2 = weapon2Box.Text:match("^%s*(.-)%s*$")
				
				local currentWeaponName = weaponToggle and w2 or w1
				
				if currentWeaponName and currentWeaponName ~= "" then
					currentToolLabel.Text = "Đang dùng: " .. currentWeaponName
					local tool = equipTool(currentWeaponName)

					if tool then
						-- 1. Bấm phím kỹ năng Z, X, C
						for _, key in ipairs(keys) do
							if not isFarming then break end
							pressKey(key)
							task.wait(0.2)
						end

						-- 2. Spam M1 liên tục 5s
						local startTime = tick()
						while (tick() - startTime) < 5 do
							if not isFarming then break end
							-- Đảm bảo tool vẫn cầm trên tay (nếu cất tự cầm lại)
							if not character:FindFirstChild(tool.Name) then
								equipTool(currentWeaponName)
							end
							
							tool:Activate()
							task.wait(0.1)
						end

						-- 3. Đổi lượt cho Weapon tiếp theo
						weaponToggle = not weaponToggle
					else
						currentToolLabel.Text = "Đang tìm lại Tool: " .. currentWeaponName
						task.wait(0.5)
					end
				else
					currentToolLabel.Text = "Chưa nhập tên Weapon!"
					task.wait(0.5)
				end
			else
				currentToolLabel.Text = "Chờ hồi sinh..."
				task.wait(1)
			end
		else
			task.wait(0.5)
		end
	end
end)

-- VÒNG LẶP KHÓA VỊ TRÍ ÚP MẶT XUỐNG BOSS (TỰ ĐỘNG CHỜ HỒI SINH)
RunService.Heartbeat:Connect(function()
	if not isFarming then return end

	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildWhichIsA("Humanoid")
	
	-- Nếu chết thì tạm dừng teleport cho tới khi respawn
	if not hrp or not humanoid or humanoid.Health <= 0 then return end

	humanoid.AutoRotate = false
	humanoid.PlatformStand = true

	local isAlive = true
	if currentTarget then
		local valuesFolder = currentTarget:FindFirstChild("Values")
		local hpValue = valuesFolder and valuesFolder:FindFirstChild("HP")
		if not currentTarget.Parent or (hpValue and hpValue.Value <= 0) then
			isAlive = false
		end
	else
		isAlive = false
	end

	if not isAlive then
		currentTarget = getClosestEnemy()
	end

	if currentTarget then
		local enemyPart = currentTarget.PrimaryPart 
			or currentTarget:FindFirstChild("HumanoidRootPart") 
			or currentTarget:FindFirstChildWhichIsA("BasePart")
			
		if enemyPart then
			local heightOffset = tonumber(heightBox.Text) or 4
			local myPosition = enemyPart.Position + Vector3.new(0, heightOffset, 0)
			
			-- Hướng mặt úp thẳng xuống Boss chuẩn xác
			hrp.CFrame = CFrame.lookAt(myPosition, enemyPart.Position, Vector3.new(0, 0, 1))
			
			-- Triệt tiêu lực vật lý
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end
end)

